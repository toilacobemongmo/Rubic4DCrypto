\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Visualization of the optimal 8-round differential characteristic trail for Rubik-4D obtained by MILP solver. Each $4 \times 4$ grid represents the 16-byte state, where shaded red squares designate active S-boxes. The cascade demonstrates that the cumulative active S-box lower bound reaches $N_{\text  {active}} = 22$, bounding the maximum differential probability to $P_{\text  {diff}} \le 2^{-132}$.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:diff_trail}{{4}{7}{Visualization of the optimal 8-round differential characteristic trail for Rubik-4D obtained by MILP solver. Each $4 \times 4$ grid represents the 16-byte state, where shaded red squares designate active S-boxes. The cascade demonstrates that the cumulative active S-box lower bound reaches $N_{\text {active}} = 22$, bounding the maximum differential probability to $P_{\text {diff}} \le 2^{-132}$}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Diffusion dynamics and MILP security lower bounds of Rubik-4D: (a) Avalanche bit-flip ratio under 1-bit plaintext and 1-bit key modifications, demonstrating rapid convergence to the theoretical Strict Avalanche Criterion (SAC) binomial center ($50\%$) within 3 rounds; (b) Cumulative active S-box lower bound scan obtained via branch-and-cut MILP solver across rounds $1 \dots  8$, surpassing the 128-bit differential security margin at round 8 ($N_{\text  {active}} = 22 \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}P_{\text  {diff}} \le 2^{-132} < 2^{-128}$).}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:avalanche_diffusion}{{5}{7}{Diffusion dynamics and MILP security lower bounds of Rubik-4D: (a) Avalanche bit-flip ratio under 1-bit plaintext and 1-bit key modifications, demonstrating rapid convergence to the theoretical Strict Avalanche Criterion (SAC) binomial center ($50\%$) within 3 rounds; (b) Cumulative active S-box lower bound scan obtained via branch-and-cut MILP solver across rounds $1 \dots 8$, surpassing the 128-bit differential security margin at round 8 ($N_{\text {active}} = 22 \implies P_{\text {diff}} \le 2^{-132} < 2^{-128}$)}{figure.caption.8}{}}
