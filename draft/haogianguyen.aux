\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Visualization of the optimal 8-round differential characteristic trail for Rubik-4D obtained by MILP solver. Each $4 \times 4$ grid represents the 16-byte state, where shaded red squares designate active S-boxes. The cascade demonstrates that the cumulative active S-box lower bound reaches $N_{\text  {active}} = 22$, bounding the maximum differential probability to $P_{\text  {diff}} \le 2^{-132}$.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:diff_trail}{{2}{7}{Visualization of the optimal 8-round differential characteristic trail for Rubik-4D obtained by MILP solver. Each $4 \times 4$ grid represents the 16-byte state, where shaded red squares designate active S-boxes. The cascade demonstrates that the cumulative active S-box lower bound reaches $N_{\text {active}} = 22$, bounding the maximum differential probability to $P_{\text {diff}} \le 2^{-132}$}{figure.caption.6}{}}
