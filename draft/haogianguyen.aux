\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Geometric representation of the Rubik-4D 128-bit internal state over a four-dimensional hypercube (tesseract, $\{0, 1\}^4$). State bytes $B_0 \dots  B_{15}$ are mapped to 16 distinct vertices. Discrete double orthogonal rotations from Lie group $SO(4)$ act simultaneously across pairs of orthogonal 2D planes (e.g., $\mathcal  {P}_1$ and $\mathcal  {P}_2$), avoiding invariant axes and ensuring full coordinate mixing.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:tesseract_4d}{{1}{3}{Geometric representation of the Rubik-4D 128-bit internal state over a four-dimensional hypercube (tesseract, $\{0, 1\}^4$). State bytes $B_0 \dots B_{15}$ are mapped to 16 distinct vertices. Discrete double orthogonal rotations from Lie group $SO(4)$ act simultaneously across pairs of orthogonal 2D planes (e.g., $\mathcal {P}_1$ and $\mathcal {P}_2$), avoiding invariant axes and ensuring full coordinate mixing}{figure.caption.3}{}}
